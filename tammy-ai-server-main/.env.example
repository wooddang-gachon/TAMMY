# 이 파일을 .env로 복사해서 값을 채우세요. 실제 키는 절대 커밋하지 마세요.
#
#   cp .env.example .env

# ---- 필수 ----
# Google AI Studio API 키. GOOGLE_API_KEY로도 인식됩니다.
# Cloud Run에서는 Secret Manager로 주입하세요.
GEMINI_API_KEY=

# ---- 서버 ----
PORT=8000
GIN_MODE=release

# 서비스 서버와 공유하는 내부 API 키.
# 비워두면 인증 미들웨어가 비활성화됩니다(Cloud Run IAM으로 보호하는 경우에만 권장).
INTERNAL_API_KEY=

# ---- 모델 ----
# 프롬프트 frontmatter의 model 값을 덮어씁니다. 비워두면 frontmatter 값을 사용합니다.
VISION_MODEL=
CHAT_MODEL=
REPORT_MODEL=
RESEARCH_MODEL=

# ---- 제한 ----
IMAGE_FETCH_TIMEOUT=15s
MAX_IMAGE_BYTES=8388608
REQUEST_TIMEOUT=120s
